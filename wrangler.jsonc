{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frenchjumper-bot",
  "account_id": "488c008885a1dc66fd4c52776130ea46",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
