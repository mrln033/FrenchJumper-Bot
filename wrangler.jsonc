{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frenchjumper-bot",
  "account_id": "488c008885a1dc66fd4c52776130ea46",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "vars": {
    "ALLOWED_GUILD_IDS": "442710603300208652",
    "ENTROPIA_API_BASE_URL": "https://api.entropiacentral.com",
    "MEMBERS_API_URL": "https://script.google.com/macros/s/AKfycbzwUDJBSb--QOij9g1nnh9Ex8nXEa3iwedfNtMEZCbPbB-ruoyuQIeP6u-fAsGdrZ3W8Q/exec?action=getMembres",
    "ENTROPIA_POLLING_ENABLED": "false",
    "ENTROPIA_PUBLISH_ENABLED": "false",
    "ENTROPIA_DISCORD_CHANNEL_ID": "",
    "ENTROPIA_ROSTER_REFRESH_MINUTES": "360",
    "ENTROPIA_INITIAL_LOOKBACK_MINUTES": "10",
    "ENTROPIA_OVERLAP_SECONDS": "300",
    "ENTROPIA_PAGE_SIZE": "30",
    "ENTROPIA_MAX_PAGES": "10"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frenchjumper-bot",
      "database_id": "4cbcf850-9593-42fb-8397-7dfca3565519",
      "migrations_dir": "migrations"
    }
  ]
}
